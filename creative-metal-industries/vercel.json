{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "comment": "Static assets under public/ are served by the filesystem handler, which only sets cache-control for /_build/assets/*. Without this they were revalidated on every request.",
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "comment": "Sitemaps and robots change on deploy, so allow a short cache but let crawlers revalidate.",
      "source": "/(sitemap[^/]*\\.xml|robots\\.txt|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
