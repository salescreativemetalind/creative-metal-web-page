{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!.well-known).*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.creativemetalind.com/:path*",
      "permanent": true
    },
    { "source": "/blog/ss-304-stainless-steel-guide", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/ss-316l-stainless-steel-guide", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/ss-304-vs-316l", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/ss-304-vs-ss-304l", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/ss-316-vs-ss-316l", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/ss-304-vs-ss-316-difference", "destination": "/ss-304-316l-pipe-supplier-india", "permanent": true },
    { "source": "/blog/carbon-steel-pipe-guide", "destination": "/carbon-steel-pipe-supplier-india", "permanent": true },
    { "source": "/blog/sa-516-carbon-steel-plate-guide", "destination": "/carbon-steel-sa516-plate-stockist-india", "permanent": true },
    { "source": "/blog/api-5l-pipe-guide", "destination": "/api-5l-line-pipe-supplier-india", "permanent": true },
    { "source": "/blog/p11-vs-p22-difference", "destination": "/alloy-steel-pipe-supplier-india", "permanent": true },
    { "source": "/blog/super-duplex-2507-guide", "destination": "/super-duplex-2507-pipe-supplier", "permanent": true },
    { "source": "/blog/inconel-625-guide", "destination": "/inconel-pipe-supplier-india", "permanent": true },
    { "source": "/blog/titanium-grades-comparison", "destination": "/titanium-pipe-supplier-india", "permanent": true },
    { "source": "/ss-pipe-supplier-vadodara", "destination": "/stainless-steel-supplier-vadodara", "permanent": true },
    { "source": "/ss-pipe-supplier-baroda", "destination": "/stainless-steel-supplier-vadodara", "permanent": true },
    { "source": "/metal-trading", "destination": "/products", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap[^/]*\\.xml|robots\\.txt|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
