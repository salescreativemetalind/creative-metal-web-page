# ══════════════════════════════════════════════════════════════
# Creative Metal Industries — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# ══════════════════════════════════════════════════════════════

# ── Email (contact form) ─────────────────────────────────────
# Gmail address + App Password for sending enquiry emails
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# ── Admin Panel ──────────────────────────────────────────────
# Token for /admin/reviews — use a strong random string
ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE

# ── Public Site IDs (safe to expose — they ship in the HTML) ──
# Google Analytics 4 Measurement ID, e.g. G-ABC1234XYZ.
# Leave blank/unset to omit the analytics script entirely.
VITE_GA4_ID=

# Google Search Console HTML-tag verification code (the `content`
# value only, not the whole meta tag). Leave unset if you verified
# via DNS or another method.
VITE_GSC_VERIFICATION=
